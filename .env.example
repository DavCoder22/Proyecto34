# Reemplaza CAMBIAR_PASSWORD, CAMBIAR_SECRET_KEY y CAMBIAR_TOKEN antes de usar.
# PostgreSQL - Configuración para Postgres
POSTGRES_USER=bi_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD
POSTGRES_DB=bi_dw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Destino del ETL:
#   sqlite   -> Jupyter local (solo 03_dw/dw.db)
#   postgres -> Neon en la nube o PostgreSQL del Superset local
#   both     -> escribe en ambos destinos
# Si se omite, usa postgres cuando DATABASE_URL está definida y sqlite cuando no.
ETL_TARGET=sqlite

# URL del Data Warehouse (PostgreSQL/Neon). Obligatoria si ETL_TARGET=postgres.
DATABASE_URL=postgresql+psycopg2://bi_user:CAMBIAR_PASSWORD@postgres:5432/bi_dw
# Poner en 0 para omitir la escritura en PostgreSQL aunque ETL_TARGET=postgres.
LOAD_POSTGRES=1
# Si se define en 1, el ETL falla cuando no puede cargar a PostgreSQL.
# REQUIRE_POSTGRES_LOAD=1

# Jupyter Notebook
JUPYTER_TOKEN=CAMBIAR_TOKEN
# Ejecutar el ETL al arrancar Jupyter para refrescar PostgreSQL.
RUN_ETL_ON_START=1

# Apache Superset
SUPERSET_SECRET_KEY=CAMBIAR_SECRET_KEY
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASS=CAMBIAR_PASSWORD
SUPERSET_ADMIN_EMAIL=admin@poc.com
# Base de metadatos de Superset. SQLite persistente por defecto.
SUPERSET_METADATA_DATABASE_URL=sqlite:////app/superset_home/superset.db
# Para usar PostgreSQL como metadatos, crear antes la base "superset" y usar:
# SUPERSET_METADATA_DATABASE_URL=postgresql+psycopg2://bi_user:CAMBIAR_PASSWORD@postgres:5432/superset
# Puerto público del stack independiente de Superset.
SUPERSET_PORT=8088
# Superset detrás de HTTP (local). En producción con HTTPS puede quedar en true.
SUPERSET_TALISMAN_ENABLED=false
# Crear automáticamente el dashboard Sales Analytics al iniciar Superset.
SUPERSET_BOOTSTRAP_DASHBOARD=1
# Nombre lógico de la conexión al DW dentro de Superset.
SUPERSET_DW_DATABASE_NAME=PoC DW
# Opcional: URL específica del DW para Superset. Si no se define, usa DATABASE_URL.
# SUPERSET_DW_DATABASE_URL=postgresql+psycopg2://bi_user:CAMBIAR_PASSWORD@postgres:5432/bi_dw
