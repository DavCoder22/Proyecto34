# PostgreSQL - Configuración para Postgres
POSTGRES_USER=bi_user
POSTGRES_PASSWORD=bi_pass
POSTGRES_DB=bi_dw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# URL del Data Warehouse. Si está definida, el ETL carga en SQLite y también en PostgreSQL.
DATABASE_URL=postgresql+psycopg2://bi_user:bi_pass@postgres:5432/bi_dw
# Poner en 0 para cargar solo SQLite.
LOAD_POSTGRES=1
# Si se define en 1, el ETL falla cuando no puede cargar a PostgreSQL.
# REQUIRE_POSTGRES_LOAD=1

# Jupyter Notebook
JUPYTER_TOKEN=bi_poc
# Ejecutar el ETL al arrancar Jupyter para refrescar PostgreSQL.
RUN_ETL_ON_START=1

# Apache Superset
SUPERSET_SECRET_KEY=bi_poc_superset_secret
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASS=admin
SUPERSET_ADMIN_EMAIL=admin@poc.com
# Base de metadatos de Superset. SQLite persistente por defecto.
SUPERSET_METADATA_DATABASE_URL=sqlite:////app/superset_home/superset.db
# Para usar PostgreSQL como metadatos, crear antes la base "superset" y usar:
# SUPERSET_METADATA_DATABASE_URL=postgresql+psycopg2://bi_user:bi_pass@postgres:5432/superset
# Puerto público del stack independiente de Superset.
SUPERSET_PORT=8088
# Superset detrás de HTTP (local). En producción con HTTPS puede quedar en true.
SUPERSET_TALISMAN_ENABLED=false
# Crear automáticamente el dashboard Sales Analytics al iniciar Superset.
SUPERSET_BOOTSTRAP_DASHBOARD=1
# Nombre lógico de la conexión al DW dentro de Superset.
SUPERSET_DW_DATABASE_NAME=PoC DW
# Opcional: URL específica del DW para Superset. Si no se define, usa DATABASE_URL.
# SUPERSET_DW_DATABASE_URL=postgresql+psycopg2://bi_user:bi_pass@postgres:5432/bi_dw
