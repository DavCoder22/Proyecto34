# PostgreSQL - Configuración para Postgres
POSTGRES_USER=bi_user
POSTGRES_PASSWORD=bi_pass
POSTGRES_DB=bi_dw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# URL de conexión JDBC/SQLAlchemy
DATABASE_URL=postgresql+psycopg2://bi_user:bi_pass@postgres:5432/bi_dw

# Jupyter Notebook
JUPYTER_TOKEN=bi_poc

# Apache Superset
SUPERSET_SECRET_KEY=bi_poc_superset_secret
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASS=admin
SUPERSET_ADMIN_EMAIL=admin@poc.com
