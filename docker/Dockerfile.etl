FROM python:3.11-slim

LABEL org.opencontainers.image.title="PoC Analisis Comercial - ETL"
LABEL org.opencontainers.image.description="Carga el data warehouse de la PoC en PostgreSQL o Neon"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    LOAD_POSTGRES=1 \
    REQUIRE_POSTGRES_LOAD=1

WORKDIR /app

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY 01_datos /app/01_datos
COPY 02_etl /app/02_etl
COPY 03_dw /app/03_dw
COPY 04_dashboard /app/04_dashboard
COPY 06_calidad /app/06_calidad

RUN mkdir -p /app/03_dw /app/06_calidad

CMD ["python", "02_etl/main.py"]
