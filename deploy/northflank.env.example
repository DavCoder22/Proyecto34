# Variables para el grupo de secretos de Northflank.
# No subas este archivo con credenciales reales.
# Reemplaza los valores entre <>.

# Opción A: en Northflank, enlaza POSTGRES_URI del addon con el alias DATABASE_URL.
# Opción B: si usas Neon, pega aquí la conexión directa (sin -pooler).
# DATABASE_URL=postgresql+psycopg2://<usuario>:<password>@<host>.neon.tech/<base>?sslmode=require
DATABASE_URL=postgresql+psycopg2://<usuario>:<password>@<host>:5432/<base>

LOAD_POSTGRES=1
REQUIRE_POSTGRES_LOAD=1

SUPERSET_SECRET_KEY=<genera-una-clave-larga-con-openssl-rand-hex-32>
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASS=<password-fuerte>
SUPERSET_ADMIN_EMAIL=admin@poc.com
SUPERSET_CREATE_ADMIN=1

# Metadata de Superset. Usa un volumen persistente en /app/superset_home.
SUPERSET_METADATA_DATABASE_URL=sqlite:////app/superset_home/superset.db

# Si Superset está detrás del proxy HTTPS de Northflank.
SUPERSET_TALISMAN_ENABLED=false
SUPERSET_COOKIE_SECURE=false

SUPERSET_BOOTSTRAP_DASHBOARD=1
SUPERSET_DW_DATABASE_NAME=PoC DW
